SHADPS4_REUSE_DESCRIPTOR_STORAGE=1
ISS_UNIFIED_RANGE=0x1048000000:0x20000000
# Blended draws into this color target stay on the command processor: the pause menu reuses it as its
# UI layer and native blended segments there hung the GPU. Castlesea's default 203d70000 is in its heap
# C (0x200000000); this port's runtime maps heap C at 0x1068000000, the same target is at 0x106BD70000.
ISS_NATIVE_PASSES_BLEND_DENY=106BD70000

# Integrated input/HUD fixes and the user-tested stability workarounds.
ISS_DIRECT_MOUSE_AIM=1
ISS_EXPERIMENTAL_HUD_CORNERS=1
# BB_PIPELINE_CACHE=0  (turned off: keep the shader pipeline cache between launches to avoid first-look stutter)
ISS_TEX_FAULT_STREAK_KB=0

# Guarded quick-power switching and image-backed wheel; live toggle in Controls.
ISS_POWER_WHEEL_TEST=1

# Save-specific trophy tracking and verified recovery.
ISS_TROPHIES_PER_SAVE=1
# ISS_SUBMIT_INTERVAL_US=2000: send work to the GPU at least every 2 ms (measured +4% avg FPS, no pop-in; 1000 caused texture pop-in). Backup: defaults.env.before-interval2000
ISS_SUBMIT_INTERVAL_US=2000
# Bundle 2026-10-29 (needs out\tlg-probe-v2.exe.bundle): blind A/B vs shipped = same FPS, ~26% fewer >33 ms frames.
ISS_NATIVE_PASS_MERGE=1
ISS_FRAMES_AHEAD=1
# 2026-10-29: barriers between the game's draws/dispatches wait for the game's own sync (blind A/B +9.3% FPS, fewer stutters). Needs the guestsync exe.
ISS_GUEST_SYNC_BARRIERS=1
# Optional diagnostics: TLG_HITCH_REPORT_MS=200 logs every freeze over 200 ms and every slowdown under 20 fps.
# 2026-11-04: night lighting fix. Renderer v2 cut a 2.5 GB game table to 64 MB to save video memory; the night baked lighting lives past that (far buildings floodlit, near roofs and Delsin dark). 0 = no cut. Measured: ~1 fps, +2.5 GB video memory (6.5 GB at 2560x1440).
ISS_HUGE_READ_WINDOW_MB=0
# 2026-11-04: smoke flicker fix (vents, burning cars, drained smoke). Barriers after the GPU particle sorting, which NVIDIA's 32-wide groups split. Needs this package's exe. Measured: no fps cost.
ISS_WAVE_BARRIERS=1
# 2026-11-03: faster lighting shader (ce1675e0, same picture; 2.7 -> 0.46 ms per frame at 2560x1440, ~+25% FPS standing on an RTX 3080 Ti). Needs gpu_v2\shader_swap\ce1675e0.22484.spv. Remove this line to turn it off.
ISS_SHADER_SWAP_DIR=../gpu_v2/shader_swap
# 2026-11-05: weaker PCs: the easy way is the in-game menu (F1 > Image > Adaptive VSync). This line does the same from here and overrides that checkbox: remove the # (no spaces around =). The log's PRESENT_MODES line shows what your display offers; without FifoRelaxed it falls back to normal VSync.
#TLG_PRESENT_MODE=FifoRelaxed
# 2026-11-06: DualShock 4 over Bluetooth: controller reports every 4 ms (the setting its speaker was tested with). Remove this line for SDL's default.
SDL_JOYSTICK_HIDAPI_PS4_REPORT_INTERVAL=4

# Paper Trail offline profile and evidence handoffs.
ISS_PAPERTRAIL_LOCAL_PSN=1
